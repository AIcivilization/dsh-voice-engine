{
  "name": "dsh-voice-engine",
  "version": "0.6.0",
  "description": "声音引擎：讯飞、Edge、本机 Ming 三家声音，DSH 里直接用，也通过本机接口给别的插件和产品用；讯飞超拟人音色能返回实际读音，让模型自己查错改错。· Voice engine for DeepSeek Harness: iFLYTEK, Edge and local Ming voices, usable in DSH and by other plugins and apps through a local API.",
  "keywords": [
    "dsh-plugin",
    "dsh-plugins",
    "dsh",
    "deepseek-harness",
    "deepseek-harness-plugin",
    "deepseek",
    "cordis",
    "voice-engine",
    "voice",
    "tts",
    "text-to-speech",
    "speech",
    "iflytek",
    "xfyun",
    "edge-tts",
    "ming",
    "声音引擎",
    "语音合成",
    "配音",
    "讯飞",
    "转写"
  ],
  "license": "MIT",
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json",
    "./sdk": {
      "default": "./sdk/index.js"
    }
  },
  "files": [
    "lib/**",
    "data/catalog.json",
    "data/polyphones.json",
    "scenes/**",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "NOTICE",
    "bin/**",
    "python/**",
    "sdk/**",
    "docs/声音引擎接口.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "engines": {
    "node": ">=22.13",
    "dsh": ">=0.2.0-0 <0.3.0-0"
  },
  "scripts": {
    "test": "node --test test/*.test.js",
    "test:spike": "node --test spike/xf.test.mjs"
  },
  "bin": {
    "dsh-voice-engine": "bin/dsh-voice-engine.mjs"
  },
  "author": "AIcivilization",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AIcivilization/dsh-voice-engine.git"
  },
  "homepage": "https://github.com/AIcivilization/dsh-voice-engine#readme",
  "bugs": {
    "url": "https://github.com/AIcivilization/dsh-voice-engine/issues"
  }
}
